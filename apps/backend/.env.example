# ============================================================
# Houston Backend – Environment Variables Template
# ============================================================
# Zkopíruj tento soubor jako .env a vyplň hodnoty
# cp .env.example .env

# JWT Secret – min. 32 náhodných znaků, generuj: openssl rand -base64 32
JWT_SECRET=

# Microsoft Entra ID App Registration
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback

# PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@localhost:5432/houston_dev

# Azure Key Vault – stores connector OAuth tokens (access + refresh)
# Format: https://<vault-name>.vault.azure.net/
# Credentials: DefaultAzureCredential (Managed Identity in prod, az login in dev)
AZURE_KEYVAULT_URL=https://your-vault-name.vault.azure.net/

# Base URL for this API (used to construct OAuth redirect URIs)
API_BASE_URL=http://localhost:3000/api/v1

# Messages older than this require verified unresolved thread context before scan proposes an action.
SCAN_MESSAGE_AGE_THRESHOLD_DAYS=14

# Gmail OAuth2 App Registration (Google Cloud Console → APIs & Services → Credentials)
# Required scopes: gmail.readonly, userinfo.email
# Redirect URI to register in Google Cloud Console: {API_BASE_URL}/connectors/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional override – defaults to {API_BASE_URL}/connectors/gmail/callback
GMAIL_REDIRECT_URI=

# Slack OAuth2 App Registration (api.slack.com/apps)
# Required scopes: im:read, mpim:read, channels:read, groups:read, users:read
# Redirect URI to register in Slack App settings: {API_BASE_URL}/connectors/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional override – defaults to {API_BASE_URL}/connectors/slack/callback
SLACK_REDIRECT_URI=

# Jira OAuth2 App Registration (developer.atlassian.com/console/myapps → OAuth 2.0 3LO)
# Required scopes: read:jira-work, write:jira-work, read:jira-user, offline_access
# Redirect URI to register in Atlassian developer console: {API_BASE_URL}/connectors/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Optional override – defaults to {API_BASE_URL}/connectors/jira/callback
JIRA_REDIRECT_URI=

# OAuth callback page redirects (for desktop app use custom protocol, e.g. houston://oauth/success)
OAUTH_SUCCESS_REDIRECT=houston://oauth/success
OAUTH_ERROR_REDIRECT=houston://oauth/error

# ──────────────────────────────────────────────────────────────
# LLM providers (AiGatewayService – ADR-001 OpenAI, ADR-003 Anthropic)
# At least one API key must be set. Which provider a request uses is a
# per-user setting (Nastavení → AI model); AI_PROVIDER is the default for
# users who have not chosen one.
# ──────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_HIGH=gpt-4o

ANTHROPIC_API_KEY=
# 'fast' tier – classification, intent analysis, draft regeneration
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# 'high' tier – Houston Task response synthesis only
ANTHROPIC_MODEL_HIGH=claude-sonnet-5
